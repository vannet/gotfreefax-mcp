# Editor + OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Node (in case anyone runs npm install for mcp-remote locally)
node_modules/
npm-debug.log*
.npm/

# Local secrets — never commit
.env
.env.local
*.secret
gotfreefax_auth.txt

# MCP Registry publisher private keys — these prove ownership of the
# com.gotfreefax/* namespace. Treat like an SSH key: never commit, never
# share. If leaked, rotate by generating a new keypair and updating the
# DNS TXT record on gotfreefax.com.
*.key
*.pem
gotfreefax-mcp-publisher.*
